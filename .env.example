# Discord application credentials (Developer Portal > your app > General Information / OAuth2 / Bot).
# VITE_DISCORD_CLIENT_ID is compiled into the client, so it must be set when you run `npm run build`.
VITE_DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_PUBLIC_KEY="YOUR_DISCORD_PUBLIC_KEY"

# GEMINI_API_KEY: Optional. Used for LLM clue generation; fallback clues are used without it.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.8-flash"

# Optional server settings
# PORT=3000
# DATABASE_PATH="crossword.db"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

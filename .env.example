# Discord application credentials (Developer Portal > your app).
# VITE_DISCORD_CLIENT_ID is the Application ID (General Information) and is compiled into the
# client, so it must be set when you run `npm run build`.
VITE_DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
# OAuth2 > Client Secret
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
# Bot > Token
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
# General Information > Public Key
DISCORD_PUBLIC_KEY="YOUR_DISCORD_PUBLIC_KEY"

# Optional. Used to write clues; without it, the hand-made fallback puzzles rotate daily.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.8-flash"

# Optional. When "true", only puzzles approved with `npm run cli approve <id>` are published;
# an unapproved puzzle is replaced by a fallback puzzle on its date.
# REQUIRE_PUZZLE_APPROVAL="false"

# Optional server settings
# PORT=3000
# DATABASE_PATH="crossword.db"

# Optional. Extra hostnames the development server accepts, comma-separated (a leading dot allows
# subdomains). Cloudflare quick tunnels (*.trycloudflare.com) are always allowed.
# DEV_ALLOWED_HOSTS=".ngrok-free.app"
